{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "INSERT_YOUR_SECRET_KEY_HERE_MIN_32_CHARS",
    "Issuer": "EducationPlatformIssuer",
    "Audience": "EducationPlatformAudience"
  },
  "ReverseProxy": {
    "Routes": {
      "educationRoute": {
        "ClusterId": "educationCluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/education-platform/{**catch-all}"
        }
      }
      // ... Añade aquí las rutas del resto de tus microservicios
    },
    "Clusters": {
      "educationCluster": {
        "Destinations": {
          "destination1": { "Address": "http://education-platform:8080/" }
        }
      }
    }
  }
}
